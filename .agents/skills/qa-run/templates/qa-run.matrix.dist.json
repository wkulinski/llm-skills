{
    "outputDefaults": {
        "outputMode": "quiet-on-pass",
        "failTailLines": 120,
        "maxOutputBytes": 20000,
        "stripAnsi": true,
        "parserInputBytes": 5242880,
        "parser": "generic-tail"
    },
    "patternSets": {
        "project-php-checks": [
            "@php-safe"
        ],
        "project-js-ts-checks": [
            "@js-ts-safe"
        ]
    },
    "sectionOrder": [
        "ALWAYS_FULL",
        "ALWAYS_ON_RERUN",
        "DEPENDENCIES_CHANGED",
        "PHP_CHANGED",
        "TWIG_CHANGED",
        "JS_TS_CHANGED",
        "CSS_SCSS_CHANGED",
        "TRANSLATIONS_CHANGED",
        "YAML_CHANGED",
        "MAKEFILE_CHANGED",
        "DOCS_CHANGED",
        "QA_CONFIG_CHANGED",
        "AGENT_SKILLS_CHANGED"
    ],
    "sections": {
        "ALWAYS_FULL": {
            "patterns": [],
            "commands": [
                "./bin/proxy/yarn --proxy-quiet lint:yarn:dedupe:fix",
                "./bin/proxy/yarn --proxy-quiet lint:yarn:dedupe",
                "./bin/proxy/composer --proxy-quiet lint:composer:security",
                "./bin/proxy/yarn --proxy-quiet lint:yarn:security"
            ],
            "runOn": [
                "full"
            ],
            "requiresFinalFullPass": false
        },
        "ALWAYS_ON_RERUN": {
            "patterns": [],
            "commands": [],
            "runOn": [
                "rerun"
            ],
            "requiresFinalFullPass": false
        },
        "DEPENDENCIES_CHANGED": {
            "patterns": [
                "composer.json",
                "composer.lock",
                "package.json",
                "yarn.lock"
            ],
            "commands": [
                "./bin/proxy/composer --proxy-quiet lint:composer:dependency",
                "./bin/proxy/composer --proxy-quiet lint:composer:normalize:fix"
            ],
            "runOn": [
                "full",
                "rerun"
            ],
            "requiresFinalFullPass": true
        },
        "PHP_CHANGED": {
            "patterns": [
                "@project-php-checks"
            ],
            "cache": {
                "enabled": true
            },
            "output": {
                "failTailLines": 160
            },
            "commands": [
                "./bin/proxy/composer --proxy-quiet dump-autoload",
                "./bin/proxy/console --proxy-quiet lint:container",
                "./bin/proxy/console --proxy-quiet app:deptrac-config:generate",
                "./bin/proxy/composer --proxy-quiet lint:deptrac",
                {
                    "cmd": "./bin/proxy/composer --proxy-quiet lint:phpstan -- --error-format=json",
                    "parser": "phpstan-json"
                },
                "./bin/proxy/composer --proxy-quiet lint:php:fix",
                "./bin/proxy/composer --proxy-quiet test"
            ],
            "runOn": [
                "full",
                "rerun"
            ],
            "requiresFinalFullPass": false
        },
        "TWIG_CHANGED": {
            "patterns": [
                "**/*.twig"
            ],
            "commands": [
                "./bin/proxy/composer --proxy-quiet lint:twig:fix",
                "./bin/proxy/composer --proxy-quiet lint:twig"
            ],
            "runOn": [
                "full",
                "rerun"
            ],
            "requiresFinalFullPass": false
        },
        "JS_TS_CHANGED": {
            "patterns": [
                "@project-js-ts-checks"
            ],
            "cache": {
                "enabled": true
            },
            "commands": [
                {
                    "cmd": "./bin/proxy/yarn --proxy-quiet lint:js:fix --format json",
                    "parser": "eslint-json"
                },
                {
                    "cmd": "./bin/proxy/yarn --proxy-quiet lint:js --format json",
                    "parser": "eslint-json"
                },
                "./bin/proxy/yarn --proxy-quiet lint:ts:typecheck"
            ],
            "runOn": [
                "full",
                "rerun"
            ],
            "requiresFinalFullPass": false
        },
        "CSS_SCSS_CHANGED": {
            "patterns": [
                "**/*.css",
                "**/*.scss"
            ],
            "commands": [
                "./bin/proxy/yarn --proxy-quiet lint:style:fix",
                "./bin/proxy/yarn --proxy-quiet lint:style"
            ],
            "runOn": [
                "full",
                "rerun"
            ],
            "requiresFinalFullPass": false
        },
        "TRANSLATIONS_CHANGED": {
            "patterns": [
                "translations/**",
                "src/*/UI/Translation/**"
            ],
            "commands": [
                "./bin/proxy/composer --proxy-quiet lint:translations"
            ],
            "runOn": [
                "full",
                "rerun"
            ],
            "requiresFinalFullPass": false
        },
        "YAML_CHANGED": {
            "patterns": [
                "**/*.yml",
                "**/*.yaml"
            ],
            "commands": [
                "./bin/proxy/composer --proxy-quiet lint:yaml"
            ],
            "runOn": [
                "full",
                "rerun"
            ],
            "requiresFinalFullPass": false
        },
        "MAKEFILE_CHANGED": {
            "patterns": [
                "Makefile"
            ],
            "commands": [
                "make -qp >/dev/null || test $? -eq 1"
            ],
            "runOn": [
                "full",
                "rerun"
            ],
            "requiresFinalFullPass": false
        },
        "DOCS_CHANGED": {
            "patterns": [
                "**/*.md"
            ],
            "commands": [],
            "runOn": [
                "full",
                "rerun"
            ],
            "requiresFinalFullPass": false
        },
        "QA_CONFIG_CHANGED": {
            "patterns": [
                ".agents/qa-run.matrix.json",
                ".agents/skills/qa-run/**"
            ],
            "commands": [
                "node .agents/skills/qa-run/scripts/run-matrix.mjs --help"
            ],
            "runOn": [
                "full",
                "rerun"
            ],
            "requiresFinalFullPass": true
        },
        "AGENT_SKILLS_CHANGED": {
            "patterns": [
                ".agents/skills/**"
            ],
            "commands": [],
            "runOn": [
                "full",
                "rerun"
            ],
            "requiresFinalFullPass": false
        }
    }
}
