{
    "$schema": "https://opencode.ai/config.json",
    "small_model": "openai/gpt-5.4-mini",
    "tool_output": {
        "max_lines": 300,
        "max_bytes": 24576
    },
    "compaction": {
        "auto": true,
        "prune": true,
        "tail_turns": 3,
        "reserved": 10000
    },
    "permission": {
        // Permission rules are evaluated with the last matching pattern winning,
        // so the catch-all allow stays first and the specific denies stay last.
        // Keep this as a single "read" object: a duplicate JSON key would drop
        // the earlier rules entirely instead of merging them.
        "read": {
            "*": "allow",
            "*.env": "allow",
            "*.env.*": "allow",
            "*.env.example": "allow",
            "**/.*": "allow",
            "**/.*/*": "allow",
            "**/.*/*/**": "allow",
            // Scout attempts must not read primary artifacts from another attempt.
            // The benchmark/helper use separate report paths; the deny rules are
            // intentionally narrower than the existing workspace/tmp policy.
            "**/*primary*.report.json": "deny",
            "**/*primary*.ledger.json": "deny"
        },
        "external_directory": {
            "/tmp/*": "allow",
            "/tmp/**": "allow",
            "/tmp/**/.*": "allow",
            "/tmp/**/.*/*": "allow",
            "/tmp/**/.*/*/**": "allow"
        },
        "mate_*": "deny"
    },
    "skills": {
        "paths": [
            ".agents/skills"
        ]
    },
    "agent": {
        "title": {
            "model": "openai/gpt-5.6-luna",
            "variant": "low"
        },
        "build": {
            "prompt": "Stosuj ./AGENTS.md oraz aktywny skill jako źródła prawdy. Każdy repository-context wykonuj wyłącznie według kanonicznej polityki ./.agents/skills/_shared/references/repository-context-hybrid.md; nie deleguj scouta bez decyzji helpera i nie obchodź walidacji. Po prepare zawsze zakończ przebieg przez finalize albo abort, także po błędzie. Po zwalidowanym raporcie możesz wykonywać punktowe odczyty potrzebne do implementacji lub review.",
            "permission": {
                "task": {
                    "*": "allow"
                },
                "webfetch": "ask"
            }
        },
        "context-refresher": {
            "model": "commandcode/deepseek/deepseek-v4.1-flash",
            "variant": "max"
        },
        "context-scout-fast": {
            "model": "commandcode/deepseek/deepseek-v4.1-flash",
            "options": {
                "thinking": {
                    "type": "disabled"
                }
            }
        },
        "context-scout": {
            "model": "openai/gpt-5.6-luna",
            "variant": "high"
        },
        "frontend-ui-engineer": {
            "model": "openai/gpt-5.6-luna",
            "variant": "max"
        },
        "implementation-worker": {
            "model": "commandcode/deepseek/deepseek-v4.1-flash",
            "variant": "max"
        },
        "runtime-diagnostician": {
            "model": "commandcode/deepseek/deepseek-v4.1-flash",
            "variant": "max",
            "permission": {
                "mate_*": "allow"
            }
        }
    },
    "mcp": {
        "github": {
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer {env:GH_TOKEN}"
            }
        },
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp"
            ]
        },
        "serena": {
            "type": "local",
            "command": [
                "serena",
                "start-mcp-server",
                "--context=codex",
                "--project-from-cwd"
            ]
        },
        "codebase-memory": {
            "type": "local",
            "enabled": true,
            // Tymczasowo używamy lokalnego builda z main zamiast binarki z release v0.9.0,
            // ponieważ release ma problem z nieograniczonym zużyciem RAM podczas indeksowania
            // dużych projektów PHP: https://github.com/DeusData/codebase-memory-mcp/issues/1072
            // Należy monitorować nowe release'y i wrócić do oficjalnej binarki, gdy poprawka
            // zostanie wydana (planowana w v0.9.1-rc lub nowszej wersji).
            // Tracked wrapper dodatkowo odtwarza auto_index/auto_watch po wyczyszczeniu cache
            // i przekazuje MCP trwały cache oraz limit pamięci.
            "command": [
                "bin/codebase-memory-mcp"
            ],
            "environment": {
                "CBM_CACHE_DIR": "var/agent/persistent/codebase-memory-main",
                "CBM_WORKERS": "1",
                "CBM_MEM_BUDGET_MB": "1024",
                "CBM_DIAGNOSTICS": "1"
            }
        }
    }
}
