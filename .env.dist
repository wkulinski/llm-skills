# GitHub CLI (gh) + MCP GitHub
GH_TOKEN=

#Context7 MCP
CONTEXT7_API_KEY=

# Optional tool wrapper prefix (proxy path).
# Examples:
# - BIN_PATH="bin/proxy/"   -> uses ./bin/proxy/composer, ./bin/proxy/console, ...
# - BIN_PATH="tools/bin/"   -> uses ./tools/bin/composer, ./tools/bin/console, ...
# Leave empty to use repository-native entrypoints resolved per skill.
BIN_PATH="bin/proxy/"

# Local agent cache directory (scripts use this value when exported in shell).
CACHE_PATH="var/agent/cache/"

# Persistent OpenCode Workflow Economics reports (optional).
# Leave empty to use ${CACHE_PATH}/owc/.
OWC_PATH="var/agent/owc/"

# Stack profile and migration: .agents/skills/_shared/references/project-profiles.md
# Existing PHP consumers: set php-symfony-postgres in ACTIVE env BEFORE updating.
SKILLS_STACK_PROFILE="generic"

# Independent architecture override; activation and errors: project-profiles.md.
CQRS_MONOLITH_STANDARD_OVERRIDES="0"

# Explicit application URL used by the frontend UI skill. A URL from the
# prompt/task has priority over this value; there is no guessed route.
PLAYWRIGHT_GUI_BASE_URL=
# Loopback login URL used only by the shared bootstrap helper
# (_shared/scripts/playwright-auth-bootstrap.sh); never a generic login fallback
# or a replacement for the application URL.
PLAYWRIGHT_GUI_LOGIN_URL=
# Optional repo-relative storage state. It must resolve to a regular file under
# .playwright-cli/auth/, which is ignored by Git.
PLAYWRIGHT_GUI_STORAGE_STATE=
# Preparation always returns a private candidate for agent assessment.
# --stage saves the agent session without promotion. Reassess the candidate in
# a fresh isolated session, then --promote with non-secret --evidence; the helper
# checks technical access in a fresh context before replacing canonical state.

# Credentials for the shared bootstrap helper, consumed only for loopback
# logins. The helper keeps them in process memory: they never appear in argv,
# stdout, stderr, temporary files, or logs.
PLAYWRIGHT_GUI_USER_LOGIN=
PLAYWRIGHT_GUI_USER_PASSWORD=

# External plan review for $task-plan (see docs/CONFIGURATION.md#external-plan-review).
# HARNESS is the Paseo provider: claude (Claude Code), codex (Codex CLI), opencode (OpenCode).
# MODEL and THINKING are ids from: paseo provider models <harness> --json
# Profiles are tried in preference order 1 -> 2 -> 3; empty profiles are skipped.
# Each configured profile requires HARNESS, MODEL, THINKING and MODE.
# Incomplete profiles are skipped with a warning; valid profiles are still tried.
# MODE is the harness permission mode. Timeout is per attempt.
#PLAN_REVIEW_1_HARNESS=claude
#PLAN_REVIEW_1_MODEL=claude-sonnet-5-5
#PLAN_REVIEW_1_THINKING=low
#PLAN_REVIEW_1_MODE=auto

#PLAN_REVIEW_2_HARNESS=codex
#PLAN_REVIEW_2_MODEL=gpt-6.1-sol
#PLAN_REVIEW_2_THINKING=medium
#PLAN_REVIEW_2_MODE=auto-review

#PLAN_REVIEW_3_HARNESS=opencode
#PLAN_REVIEW_3_MODEL=commandcode/deepseek/deepseek-v4.1-flash
#PLAN_REVIEW_3_THINKING=high
#PLAN_REVIEW_3_MODE=build

#PLAN_REVIEW_TIMEOUT_SECONDS=1200
