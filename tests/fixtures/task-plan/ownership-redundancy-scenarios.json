    {
      "id": "endpoint-cross-context-redundant",
      "description": "A cross-context endpoint is retained as an explicit redundant element with a resolved finding.",
      "review": {
        "required": true,
        "requirement_basis": "critical-review",
        "requirement_decision_ref": "",
        "status": "complete",
        "subjects": [
          {
            "id": "OR6",
