            "source_claim": "The reporting endpoint duplicates Billing's invoice response.",
            "claim_classification": "requirement",
            "promotion_decision_ref": "",
            "producer_or_implementer": ["Reporting API"],
            "consumer_or_caller": ["Reporting UI"],
            "owner_source_of_truth": "Reporting API contract; Billing owns invoice state",
            "scope": "cross-context",
            "context_boundary": "Billing -> Reporting HTTP integration",
            "necessity": "The endpoint has no independent representation or consumer contract.",
            "alternative_without_subject": "Reuse the existing Billing endpoint through the integration boundary.",
            "inconsistency_or_divergence_test": "Compare both endpoint payloads and fail on response divergence.",
