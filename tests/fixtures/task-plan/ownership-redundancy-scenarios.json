          "code": "REDUNDANT_DESIGN_ELEMENT",
          "subject_id": "OR6"
        }
      ],
      "expected": {
        "review_valid": true,
        "finding_valid": true,
        "subject_kind": "endpoint",
        "scope": "cross-context",
        "redundancy_status": "redundant",
        "cross_context": "redundant",
        "finding_subject_id": "OR6"
      }
