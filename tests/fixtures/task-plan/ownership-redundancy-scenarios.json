            "redundancy_status": "redundant",
            "finding_ids": ["F2"],
            "decision_ref": ""
          }
        ]
      },
      "findings": [
        {
          "id": "F2",
          "severity": "HIGH",
          "claim": "The Reporting endpoint duplicates the Billing endpoint response.",
          "evidence": ["Both endpoints expose the same invoice representation."],
          "evidence_ref": "review:OR6",
          "impact": "Independent endpoint contracts can diverge across contexts.",
          "recommendation": "Reuse the Billing endpoint or document an independent contract.",
